{
  "name": "msmud",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "web.js",
  "bin": "web.js",
  "scripts": {
    "build": "node scripts/pack.mjs",
    "build-b": "node scripts/pack.mjs --binary",
    "dev": "vite",
    "start": "concurrently \"node web.js\" \"node main.mjs\"",
    "start-b": "npm run build-b && concurrently \"node web.js\" \"node main.mjs\"",
    "clean": "node -e \"var f=require('fs');['core','res','server/dist','www'].forEach(d=>f.rmSync(d,{recursive:true,force:true}));f.rmSync('core/templates-build.js',{force:true})\"",
    "test": "npm run test:compile && node --test tests/*.test.mjs",
    "test:compile": "tsc -p server/tsconfig.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "jquery": "^4.0.0",
    "json5": "^2.2.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-roll": "^3.1.0",
    "svg-captcha": "^1.4.0",
    "vite": "^8.0.14",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "pinyin": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "tabWidth": 4,
    "printWidth": 100,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
