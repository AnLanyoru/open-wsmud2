# 游戏名称（显示在登录界面）
VITE_GAME_NAME=MUD游戏

# Vite 启动时自动打开的浏览器地址（端口自动读取 WEB_PORT）
STARTUP_URL=0.0.0.0

# Web 服务器地址和端口
WEB_HOST=0.0.0.0
WEB_PORT=8088

# 游戏服务器 WebSocket 地址和端口
SERVER_NAME=本地测试
WS_HOST=127.0.0.1
WS_PORT=31300

# MD5 加密前缀（用于密码加密）
MD5_PREFIX='123456'

# Session 会话密钥
SESSION_SECRET='123456'

# DES 加密向量（16字节，用于数据加解密）
DESIV=1234123412341234
